{
  "name": "@zgv/ui-kit",
  "version": "0.1.0",
  "description": "Минималистичный UI-кит на React: серверные компоненты по умолчанию, светлая и тёмная темы, формы, таблицы, редактор",
  "license": "MIT",
  "type": "module",
  "keywords": ["react", "ui-kit", "components", "rsc", "ssr", "design-system"],
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.css.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/components/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:visual": "playwright test",
    "visual:ci": "npm run build-storybook && playwright test",
    "docker:visual": "docker compose run --rm visual",
    "docker:visual:update": "docker compose run --rm visual-update"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "dependencies": {
    "@tanstack/react-table": "8.20.6",
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-character-count": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "lucide-react": "0.469.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.1.1",
    "@playwright/test": "1.49.1",
    "@storybook/addon-essentials": "8.6.4",
    "@storybook/react": "8.6.4",
    "@storybook/react-vite": "8.6.4",
    "@types/node": "22.10.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "http-server": "14.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rollup-plugin-preserve-directives": "0.4.0",
    "storybook": "8.6.4",
    "typescript": "5.7.3",
    "vite": "6.2.0",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-lib-inject-css": "2.2.2"
  }
}
